TG_BOT_TOKEN=123456:telegram-bot-token
TG_CHAT_ID=123456789

IG_USERNAME=reader_account_username
IG_PASSWORD=reader_account_password
IG_TARGET_USERNAME=target_username_without_at

# Keep this at 30+ seconds. 45-90 is friendlier to Instagram.
POLL_INTERVAL=45
INITIAL_HISTORY=10

# Optional runtime paths.
DB_PATH=./bridge_state.db
IG_SESSION_FILE=./ig_session.json

# Optional: JSON from a real Android device profile used by instagrapi set_device().
# If you override this, keep the app_version/version_code current.
# IG_DEVICE_JSON={"android_version":34,"android_release":"14","dpi":"480dpi","resolution":"1344x2992","manufacturer":"Google/google","device":"husky","model":"Pixel 8 Pro","cpu":"husky","app_version":"428.0.0.47.67","version_code":"961145276","bloks_versioning_id":"7189b949425f9bf80ea8bd880cf5a3080b292d9b1c4b38a18d112f7c4b71e7a8"}

# Optional: strongly recommended on GCP/VPS. Use a stable residential/mobile
# proxy or a local SOCKS tunnel to a trusted home exit node.
# Examples:
# IG_PROXY=http://user:pass@host:port
# IG_PROXY=socks5://user:pass@host:port
# IG_PROXY=socks5://127.0.0.1:1080
# IG_PROXY=

# Optional for first login / session refresh if Instagram asks for 2FA.
# Prefer IG_TOTP_SECRET if you have the authenticator secret; otherwise use
# IG_VERIFICATION_CODE once and remove it after ig_session.json is created.
# IG_TOTP_SECRET=
# IG_VERIFICATION_CODE=

# Optional escape hatch when password login is blocked from this host/IP.
# Copy the Instagram sessionid cookie from a browser session.
# IG_SESSIONID=
# Or paste a full browser Cookie header; IG_COOKIE_TOKEN is accepted as an alias.
# IG_COOKIE_HEADER=sessionid=...; ds_user_id=...; csrftoken=...; mid=...
# IG_COOKIE_TOKEN=

IG_MARK_SEEN=false
MEDIA_TIMEOUT=30
LOG_LEVEL=INFO
